{
  "kind": "collectionType",
  "collectionName": "foundation_fundraisers",
  "info": {
    "singularName": "foundation-fundraiser",
    "pluralName": "foundation-fundraisers",
    "displayName": "Foundation Fundraiser",
    "description": "Fundraising campaigns posted by beneficiaries"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title" },
    "description": { "type": "text", "required": true },
    "fundraiseItems": { "type": "boolean", "default": true },
    "fundraiseMoney": { "type": "boolean", "default": false },
    "targetQuantity": { "type": "integer", "default": 0, "min": 0 },
    "targetAmountUGX": { "type": "biginteger", "default": 0 },
    "quantityFulfilled": { "type": "integer", "default": 0, "min": 0 },
    "amountFulfilledUGX": { "type": "biginteger", "default": 0 },
    "status": { "type": "enumeration", "enum": ["active", "completed", "archived"], "default": "active", "required": true },
    "photos": { "type": "json", "default": [] },
    "creator": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" }
  }
}
