{
  "kind": "collectionType",
  "collectionName": "entrep_jobs",
  "info": {
    "singularName": "entrep-job",
    "pluralName": "entrep-jobs",
    "displayName": "Entrep Job"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "title": { "type": "string", "required": true },
    "company": { "type": "string" },
    "companyLogo": { "type": "string" },
    "jobFunction": { "type": "string" },
    "industry": { "type": "string" },
    "experienceLevel": { "type": "string" },
    "location": { "type": "string" },
    "jobType": {
      "type": "enumeration",
      "enum": ["Full-time", "Part-time", "Internship", "Contract", "Freelance"],
      "default": "Full-time"
    },
    "salary": { "type": "string" },
    "skills": { "type": "json", "default": [] },
    "description": { "type": "text" },
    "postedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "applicationsCount": { "type": "integer", "default": 0 },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "open", "closed", "filled"],
      "default": "open"
    },
    "closingAt": { "type": "datetime" },
    "postedByProfile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-profile.entrep-profile"
    },
    "contactEmail": { "type": "string" },
    "applicationLink": { "type": "string" }
  }
}
