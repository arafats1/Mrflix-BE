{
  "kind": "collectionType",
  "collectionName": "marketplace_ads",
  "info": {
    "singularName": "marketplace-ad",
    "pluralName": "marketplace-ads",
    "displayName": "Marketplace Ad",
    "description": "Animated marketplace banner ads managed by admins"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "ctaLabel": {
      "type": "string"
    },
    "linkUrl": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "backgroundColor": {
      "type": "string",
      "default": "#073f56"
    },
    "textColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "accentColor": {
      "type": "string",
      "default": "#ff8a00"
    },
    "placement": {
      "type": "enumeration",
      "enum": ["marketplace_top", "marketplace_sidebar", "marketplace_carousel", "marketplace_general_sidebar", "marketplace_general_carousel", "homes_carousel", "homes_sidebar"],
      "required": true,
      "default": "marketplace_top"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "paused"],
      "required": true,
      "default": "active"
    },
    "priority": {
      "type": "integer",
      "default": 0
    },
    "startsAt": {
      "type": "datetime"
    },
    "endsAt": {
      "type": "datetime"
    }
  }
}
