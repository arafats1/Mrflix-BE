{
  "kind": "collectionType",
  "collectionName": "home_bookings",
  "info": {
    "singularName": "home-booking",
    "pluralName": "home-bookings",
    "displayName": "Home Booking",
    "description": "Short stay Homes reservation records"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "listing": { "type": "relation", "relation": "manyToOne", "target": "api::home-listing.home-listing" },
    "guest": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" },
    "host": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" },
    "checkIn": { "type": "date", "required": true },
    "checkOut": { "type": "date", "required": true },
    "checkInTime": { "type": "string", "default": "14:00" },
    "checkOutTime": { "type": "string", "default": "11:00" },
    "guests": { "type": "integer", "default": 1, "min": 1 },
    "roomOptionIndex": { "type": "integer", "default": 0, "min": 0 },
    "nights": { "type": "integer", "default": 1, "min": 1 },
    "amountUGX": { "type": "integer", "required": true, "min": 0 },
    "hostEarningsUGX": { "type": "integer", "default": 0, "min": 0 },
    "platformFeeUGX": { "type": "integer", "default": 0, "min": 0 },
    "serviceFeeUGX": { "type": "integer", "default": 0, "min": 0 },
    "paymentMethod": { "type": "enumeration", "enum": ["pesapal", "dgateway", "yo", "admin_granted"], "default": "pesapal" },
    "paymentPhone": { "type": "string" },
    "transactionId": { "type": "string" },
    "pesapalTrackingId": { "type": "string" },
    "dgatewayReference": { "type": "string" },
    "yoReference": { "type": "string" },
    "airtelReference": { "type": "string" },
    "status": { "type": "enumeration", "enum": ["pending", "confirmed", "checked_in", "checked_out", "cancelled", "failed", "completed", "suspended"], "default": "pending", "required": true },
    "specialRequests": { "type": "text" },
    "cancellationPolicy": { "type": "enumeration", "enum": ["flexible", "moderate", "strict"], "default": "moderate" },
    "cancelledAt": { "type": "datetime" },
    "cancelledBy": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" },
    "cancellationRefundUGX": { "type": "integer", "default": 0, "min": 0 },
    "cancellationReason": { "type": "text" },
    "guestCheckInStatus": { "type": "enumeration", "enum": ["pending", "confirmed", "no_show"], "default": "pending" },
    "hostCheckInStatus": { "type": "enumeration", "enum": ["pending", "confirmed", "no_show"], "default": "pending" },
    "guestCheckInAt": { "type": "datetime" },
    "hostCheckInAt": { "type": "datetime" },
    "walletCredited": { "type": "boolean", "default": false },
    "payoutEligibleAt": { "type": "datetime" }
  }
}
