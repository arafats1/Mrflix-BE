{
  "kind": "collectionType",
  "collectionName": "entrep_submissions",
  "info": {
    "singularName": "entrep-submission",
    "pluralName": "entrep-submissions",
    "displayName": "Entrep Practical Submission"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-course.entrep-course"
    },
    "lesson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-lesson.entrep-lesson"
    },
    "submissionType": {
      "type": "enumeration",
      "enum": ["video", "image", "audio", "text", "document"],
      "default": "text"
    },
    "mediaUrl": { "type": "string" },
    "textResponse": { "type": "text" },
    "grade": { "type": "integer" },
    "feedback": { "type": "text" },
    "status": {
      "type": "enumeration",
      "enum": ["submitted", "reviewing", "approved", "needs_revision", "rejected"],
      "default": "submitted"
    }
  }
}
