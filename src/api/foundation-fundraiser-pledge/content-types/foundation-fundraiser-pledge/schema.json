{
  "kind": "collectionType",
  "collectionName": "foundation_fundraiser_pledges",
  "info": {
    "singularName": "foundation-fundraiser-pledge",
    "pluralName": "foundation-fundraiser-pledges",
    "displayName": "Foundation Fundraiser Pledge",
    "description": "Item quantity pledges from donors toward fundraisers"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "pledgeType": { "type": "enumeration", "enum": ["items", "money"], "default": "items", "required": true },
    "quantity": { "type": "integer", "default": 0, "min": 0 },
    "amountUGX": { "type": "biginteger", "default": 0 },
    "itemDescription": { "type": "text" },
    "donorPhone": { "type": "string" },
    "fundraiser": { "type": "relation", "relation": "manyToOne", "target": "api::foundation-fundraiser.foundation-fundraiser" },
    "donor": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" }
  }
}
