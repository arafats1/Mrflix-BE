{
  "kind": "collectionType",
  "collectionName": "entrep_posts",
  "info": {
    "singularName": "entrep-post",
    "pluralName": "entrep-posts",
    "displayName": "Entrep Community Post"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "discussionGroup": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-discussion-group.entrep-discussion-group"
    },
    "title": { "type": "string" },
    "authorName": { "type": "string" },
    "authorRole": { "type": "string" },
    "content": { "type": "text" },
    "mediaUrls": { "type": "json", "default": [] },
    "tags": { "type": "json", "default": [] },
    "likesCount": { "type": "integer", "default": 0 },
    "commentsCount": { "type": "integer", "default": 0 },
    "likedBy": { "type": "json", "default": [] },
    "comments": { "type": "json", "default": [] },
    "isExpert": { "type": "boolean", "default": false },
    "isAnonymous": { "type": "boolean", "default": false },
    "postType": {
      "type": "enumeration",
      "enum": ["community", "topic", "noticeboard", "suggestion"],
      "default": "community"
    },
    "audience": {
      "type": "enumeration",
      "enum": ["public", "alumni"],
      "default": "public"
    },
    "alumniAudience": {
      "type": "enumeration",
      "enum": ["learner", "trainer", "cluster"]
    },
    "status": {
      "type": "enumeration",
      "enum": ["published", "pending", "rejected", "hidden"],
      "default": "published"
    }
  }
}
