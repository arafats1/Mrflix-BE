{
  "kind": "collectionType",
  "collectionName": "child_profiles",
  "info": {
    "singularName": "child-profile",
    "pluralName": "child-profiles",
    "displayName": "Child Profile",
    "description": "Per-child sub-profile owned by a parent account"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "dateOfBirth": {
      "type": "date",
      "required": true
    },
    "religion": {
      "type": "enumeration",
      "enum": [
        "Catholic",
        "Protestant",
        "Pentecostal",
        "Adventist",
        "Orthodox",
        "Muslim",
        "Hindu",
        "Bahai",
        "Traditional",
        "Other"
      ]
    },
    "avatarUrl": {
      "type": "string"
    },
    "childPinHash": {
      "type": "string"
    },
    "childPinUpdatedAt": {
      "type": "datetime"
    },
    "dailyWatchMinutes": {
      "type": "integer",
      "default": 60,
      "min": 0,
      "max": 1440
    },
    "blockedMovieIds": {
      "type": "json",
      "default": []
    },
    "allowedMovieIds": {
      "type": "json",
      "default": []
    },
    "savingsGoals": {
      "type": "json",
      "default": []
    },
    "totalSavingsUGX": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "unallocatedSavingsUGX": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "savingsLifetimeDepositedUGX": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "childProfiles"
    }
  }
}
