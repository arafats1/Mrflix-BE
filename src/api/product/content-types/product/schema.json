{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Physical products for sale"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "priceUGX": {
      "type": "integer",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "images": {
      "type": "json",
      "required": true
    },
    "featuredImage": {
      "type": "string",
      "required": true
    },
    "ageRange": {
      "type": "string"
    },
    "audience": {
      "type": "enumeration",
      "enum": [
        "children",
        "adults"
      ],
      "default": "children"
    },
    "stockQuantity": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 1
    },
    "seller": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "out_of_stock",
        "discontinued"
      ],
      "default": "active"
    },
    "paymentPhone": {
      "type": "string"
    },
    "paymentCode": {
      "type": "string"
    },
    "discountPercent": {
      "type": "integer",
      "max": 95,
      "min": 0
    },
    "deliveryAreas": {
      "type": "json"
    }
  }
}