{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Physical products for sale"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "specifications": {
      "type": "text"
    },
    "priceUGX": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "UGX",
        "KES",
        "TZS",
        "RWF",
        "BIF",
        "SOS",
        "SSP",
        "ETB",
        "DJF",
        "USD"
      ],
      "default": "UGX"
    },
    "category": {
      "type": "string",
      "required": true
    },
    "subcategory": {
      "type": "string"
    },
    "itemCondition": {
      "type": "enumeration",
      "enum": [
        "Brand New",
        "Second Hand"
      ]
    },
    "images": {
      "type": "json",
      "default": []
    },
    "featuredImage": {
      "type": "string",
      "default": ""
    },
    "productVideoUrl": {
      "type": "string"
    },
    "productVideoThumbnailUrl": {
      "type": "string"
    },
    "productVideoLikes": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "productVideoComments": {
      "type": "json"
    },
    "itemType": {
      "type": "enumeration",
      "enum": [
        "product",
        "service"
      ],
      "default": "product"
    },
    "saleUnit": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "productType": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "yearOfManufacture": {
      "type": "string"
    },
    "condition": {
      "type": "enumeration",
      "enum": [
        "Brand New",
        "Foreign Used",
        "Local Used"
      ]
    },
    "transmission": {
      "type": "enumeration",
      "enum": [
        "AMT",
        "Automatic",
        "CVT",
        "Manual"
      ]
    },
    "bodyType": {
      "type": "enumeration",
      "enum": [
        "SUV",
        "Station Wagon",
        "Sedan",
        "Pickup",
        "Minivan",
        "MPV",
        "Hatchback",
        "Crossover",
        "Coupe",
        "Convertible"
      ]
    },
    "secondHandCondition": {
      "type": "enumeration",
      "enum": [
        "After crash",
        "Engine issue",
        "First owner",
        "First registration",
        "Gear issue",
        "Need body repair",
        "Need repainting",
        "Need repair",
        "Original parts",
        "Unpainted",
        "Wiring problems",
        "No faults"
      ]
    },
    "engineSize": {
      "type": "enumeration",
      "enum": [
        "Engine 3000 cc",
        "Engine 2500 cc",
        "Engine 2400 cc",
        "Engine 2000 cc",
        "Engine 1500 cc",
        "Engine 700 cc",
        "Engine 6000 cc",
        "Engine 5700 cc",
        "Engine 5500 cc",
        "Engine 5000 cc",
        "Engine 4700 cc",
        "Engine 4600 cc",
        "Engine 4500 cc",
        "Engine 4400 cc",
        "Engine 4200 cc",
        "Engine 4000 cc",
        "Engine 3800 cc",
        "Engine 3700 cc",
        "Engine 3600 cc",
        "Engine 3500 cc",
        "Engine 3400 cc",
        "Engine 3300 cc",
        "Engine 3200 cc",
        "Engine 2900 cc",
        "Engine 2800 cc",
        "Engine 2700 cc",
        "Engine 2300 cc",
        "Engine 2200 cc",
        "Engine 2100 cc",
        "Engine 1800 cc",
        "Engine 1600 cc",
        "Engine 1400 cc",
        "Engine 1300 cc",
        "Engine 1200 cc",
        "Engine 1000 cc"
      ]
    },
    "fuelType": {
      "type": "enumeration",
      "enum": [
        "Plug-in Hybrid",
        "Petrol",
        "Mild Hybrid",
        "Hybrid",
        "Electric",
        "Diesel",
        "CNG"
      ]
    },
    "negotiable": {
      "type": "boolean",
      "default": false
    },
    "hirePurchaseMonthlyUGX": {
      "type": "integer",
      "min": 0
    },
    "hirePurchaseDepositPercent": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "hirePurchaseTerms": {
      "type": "text"
    },
    "showCarMonthlyPayment": {
      "type": "boolean",
      "default": false
    },
    "ageRange": {
      "type": "string"
    },
    "audience": {
      "type": "enumeration",
      "enum": [
        "children",
        "adults",
        "both"
      ],
      "default": "children"
    },
    "marketplaceSource": {
      "type": "enumeration",
      "enum": [
        "core",
        "entrepreneur"
      ],
      "default": "core"
    },
    "stockQuantity": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 1
    },
    "seller": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "active",
        "out_of_stock",
        "discontinued"
      ],
      "default": "active"
    },
    "draftMeta": {
      "type": "json"
    },
    "paymentPhone": {
      "type": "string"
    },
    "paymentCode": {
      "type": "string"
    },
    "discountPercent": {
      "type": "integer",
      "max": 95,
      "min": 0
    },
    "deliveryAreas": {
      "type": "json"
    },
    "serviceAvailabilityDates": {
      "type": "json"
    },
    "serviceBookedDates": {
      "type": "json"
    },
    "promotedUntil": {
      "type": "datetime"
    },
    "promotionKind": {
      "type": "enumeration",
      "enum": [
        "product",
        "seller"
      ]
    },
    "promotionBadgeLabel": {
      "type": "string"
    }
  }
}