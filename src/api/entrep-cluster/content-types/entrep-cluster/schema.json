    "contactPerson": { "type": "string" },
    "contactEmail": { "type": "string" },
    "contactPhone": { "type": "string" },
    "description": { "type": "text" },
    "industryCategory": { "type": "string" },
    "code": { "type": "string", "unique": true },
    "members": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::entrep-profile.entrep-profile",
      "mappedBy": "cluster"
    }
  }
