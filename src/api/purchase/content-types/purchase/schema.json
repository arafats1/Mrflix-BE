{
  "kind": "collectionType",
  "collectionName": "purchases",
  "info": {
    "singularName": "purchase",
    "pluralName": "purchases",
    "displayName": "Purchase",
    "description": "Movie purchase records"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "movie": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::movie.movie"
    },
    "providerMaterial": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::provider-material.provider-material"
    },
    "buyer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "childProfile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::child-profile.child-profile"
    },
    "amount": {
      "type": "integer",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "default": 1,
      "min": 1
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": ["mtn_momo", "airtel_money", "pesapal", "dgateway", "yo", "pay_on_delivery", "manual_supplier_payment", "free_trial", "referral_referred", "referral_referrer"],
      "required": true
    },
    "paymentPhone": {
      "type": "string"
    },
    "transactionId": {
      "type": "string"
    },
    "customerTransactionId": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "completed", "failed"],
      "default": "pending",
      "required": true
    },
    "deliveryStatus": {
      "type": "enumeration",
      "enum": ["pending_delivery", "delivered", "not_delivered"],
      "default": "pending_delivery"
    },
    "downloadCount": {
      "type": "integer",
      "default": 0
    },
    "seasonNumber": {
      "type": "integer"
    },
    "pesapalTrackingId": {
      "type": "string"
    },
    "dgatewayReference": {
      "type": "string"
    },
    "yoReference": {
      "type": "string"
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "isPayOnDelivery": {
      "type": "boolean",
      "default": false
    },
    "deliveryAddress": {
      "type": "text"
    },
    "deliveryPhone": {
      "type": "string"
    },
    "contactName": {
      "type": "string"
    },
    "book": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::book.book"
    },
    "purchaseType": {
      "type": "enumeration",
      "enum": ["read", "download", "book_subscription"]
    },
    "savingsDepositApplied": {
      "type": "boolean",
      "default": false
    },
    "expiresAt": {
      "type": "datetime"
    },
    "serviceDate": {
      "type": "date"
    }
  }
}
