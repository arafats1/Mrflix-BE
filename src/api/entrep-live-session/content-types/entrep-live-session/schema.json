{
  "kind": "collectionType",
  "collectionName": "entrep_live_sessions",
  "info": {
    "singularName": "entrep-live-session",
    "pluralName": "entrep-live-sessions",
    "displayName": "Entrep Live Session",
    "description": "Scheduled live training sessions (Whereby-backed)"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "title": { "type": "string", "required": true },
    "description": { "type": "text" },
    "topic": { "type": "string" },
    "startsAt": { "type": "datetime", "required": true },
    "endsAt": { "type": "datetime" },
    "durationMinutes": { "type": "integer", "default": 60 },
    "trainer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-profile.entrep-profile"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-course.entrep-course"
    },
    "cluster": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-cluster.entrep-cluster"
    },
    "provider": {
      "type": "enumeration",
      "enum": ["whereby", "zoom", "jitsi"],
      "default": "whereby"
    },
    "hostRoomUrl": { "type": "text", "private": true },
    "viewerRoomUrl": { "type": "text" },
    "wherebyMeetingId": { "type": "string", "private": true },
    "recordingUrl": { "type": "text" },
    "recordingS3Key": { "type": "text", "private": true },
    "transcriptUrl": { "type": "text" },
    "transcriptS3Key": { "type": "text", "private": true },
    "status": {
      "type": "enumeration",
      "enum": ["scheduled", "live", "ended", "cancelled"],
      "default": "scheduled"
    },
    "audience": {
      "type": "enumeration",
      "enum": ["public", "course", "cluster", "alumni"],
      "default": "public"
    },
    "alumniAudience": {
      "type": "enumeration",
      "enum": ["learner", "trainer", "cluster"]
    },
    "attendees": { "type": "json", "default": [] },
    "cloudMediaEnabled": { "type": "boolean", "default": false }
  }
}
