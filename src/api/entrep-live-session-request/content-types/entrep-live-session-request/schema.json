{
  "kind": "collectionType",
  "collectionName": "entrep_live_session_requests",
  "info": {
    "singularName": "entrep-live-session-request",
    "pluralName": "entrep-live-session-requests",
    "displayName": "Entrep Live Session Request"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-course.entrep-course"
    },
    "trainer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::entrep-profile.entrep-profile"
    },
    "requester": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "topic": { "type": "string" },
    "message": { "type": "text" },
    "scheduledAt": { "type": "datetime" },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "accepted", "rejected"],
      "default": "pending"
    },
    "liveSession": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::entrep-live-session.entrep-live-session"
    }
  }
}